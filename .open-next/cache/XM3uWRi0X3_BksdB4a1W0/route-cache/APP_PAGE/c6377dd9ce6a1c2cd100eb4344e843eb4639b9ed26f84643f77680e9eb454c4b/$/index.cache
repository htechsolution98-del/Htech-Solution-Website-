 y1=\"21\" x2=\"12\" y2=\"23\"></line><line x1=\"4.22\" y1=\"4.22\" x2=\"5.64\" y2=\"5.64\"></line><line x1=\"18.36\" y1=\"18.36\" x2=\"19.78\" y2=\"19.78\"></line><line x1=\"1\" y1=\"12\" x2=\"3\" y2=\"12\"></line><line x1=\"21\" y1=\"12\" x2=\"23\" y2=\"12\"></line><line x1=\"4.22\" y1=\"19.78\" x2=\"5.64\" y2=\"18.36\"></line><line x1=\"18.36\" y1=\"5.64\" x2=\"19.78\" y2=\"4.22\"></line></g></svg></button><div style=\"display:inline-block\"><a href=\"#contact\" class=\"btn btn-primary\" style=\"padding:11px 22px;font-size:14px\" data-hover=\"true\">Let&#x27;s Talk</a></div><button class=\"hBw1pG_menuBtn\" id=\"menuBtn\" aria-label=\"Open menu\"><span></span><span></span><span></span></button></div></nav></div></header><main id=\"top\" style=\"position:relative;z-index:1;background-color:var(--bg-0)\"><section class=\"ZARIfG_hero\"><div class=\"ZARIfG_heroBackground\"><!--$!--><template data-dgst=\"\"></template><!--/$--><div class=\"ZARIfG_gridOverlay\"></div><div class=\"ZARIfG_glow1\"></div><div class=\"ZARIfG_glow2\"></div></div><div class=\"wrap ZARIfG_heroContainer\"><div class=\"ZARIfG_heroContent reveal in\"><div class=\"eyebrow\">Htech Solutions Pvt. Ltd. · Est. 2014</div><h1><div class=\"\" style=\"display:inline-flex;flex-wrap:wrap;overflow:hidden;opacity:0\"><span style=\"margin-right:0.25em;display:inline-block;opacity:0;transform:translateY(40px)\">Innovating</span><span style=\"margin-right:0.25em;display:inline-block;opacity:0;transform:translateY(40px)\">With</span><span style=\"margin-right:0.25em;display:inline-block;opacity:0;transform:translateY(40px)\">Code.</span></div><br/><div class=\"\" style=\"display:inline-flex;flex-wrap:wrap;overflow:hidden;opacity:0\"><span style=\"margin-right:0.25em;display:inline-block;opacity:0;transform:translateY(40px)\">Building</span><span style=\"margin-right:0.25em;display:inline-block;opacity:0;transform:translateY(40px)\">the</span><span style=\"margin-right:0.25em;display:inline-block;opacity:0;transform:translateY(40px)\">Future.</span></div></h1><p class=\"lead\" style=\"margin-top:24px\">We transform ideas into secure, scalable, high‑performance software — web, mobile, AI and cloud systems built for businesses that demand reliability and scale.</p><div class=\"ZARIfG_heroActions\"><div style=\"display:inline-block\"><a href=\"#contact\" class=\"btn btn-primary\" data-hover=\"true\">Start Your Project <span class=\"btn-arrow\">→</span></a></div><div style=\"display:inline-block\"><a href=\"#services\" class=\"btn btn-ghost\" data-hover=\"true\">Explore Our Services</a></div></div><div class=\"ZARIfG_heroMeta\"><div class=\"ZARIfG_metaItem\"><b>10+</b><span>Years Building</span></div><div class=\"ZARIfG_divider\"></div><div class=\"ZARIfG_metaItem\"><b>20+</b><span>Projects Shipped</span></div><div class=\"ZARIfG_divider\"></div><div class=\"ZARIfG_metaItem\"><b>15+</b><span>Clients Served</span></div></div></div><div class=\"ZARIfG_heroImageWrapper reveal in\" style=\"transition-delay:.15s\"><div class=\"ZARIfG_imageCard\"><div class=\"ZARIfG_cardHeader\"><div class=\"ZARIfG_dots\"><span class=\"ZARIfG_dot\"></span><span class=\"ZARIfG_dot\"></span><span class=\"ZARIfG_dot\"></span></div></div><div class=\"ZARIfG_cardBody\"><div class=\"ZARIfG_mockupCode\"><p><span class=\"ZARIfG_keyword\">const</span> <span class=\"ZARIfG_variable\">enterpriseSolution</span> = <span class=\"ZARIfG_keyword\">new</span> <span class=\"ZARIfG_class\">Architecture</span>({</p><p class=\"ZARIfG_indent\">scale: <span class=\"ZARIfG_string\">&quot;infinite&quot;</span>,</p><p class=\"ZARIfG_indent\">security: <span class=\"ZARIfG_string\">&quot;zero-trust&quot;</span>,</p><p class=\"ZARIfG_indent\">performance: <span class=\"ZARIfG_string\">&quot;optimized&quot;</span>,</p><p>});</p><br/><p><span class=\"ZARIfG_keyword\">await</span> enterpriseSolution.<span class=\"ZARIfG_function\">deploy</span>();</p><p class=\"ZARIfG_comment\">// Output: System running with 99.99% uptime</p></div></div></div></div></div></section><section class=\"section\" id=\"about\"><div class=\"wrap vAULUW_aboutGrid\"><div class=\"reveal\"><div class=\"vAULUW_aboutPanel\"><div class=\"vAULUW_line\"><span class=\"vAULUW_k\">company</span><span class=\"vAULUW_v\">Htech Solutions Pvt. Ltd.</span></div><div class=\"vAULUW_line\"><span class=\"vAULUW_k\">founded</span><span class=\"vAULUW_v\">2014</span></div><div class=\"vAULUW_line\"><span class=\"vAULUW_k\">hq</span><span class=\"vAULUW_v\">Ahmedabad, India</span></div><div class=\"vAULUW_line\"><span class=\"vAULUW_k\">focus</span><span class=\"vAULUW_v\">Software · AI · Cloud · Digital Transformation</span></div><div class=\"vAULUW_line\"><span class=\"vAULUW_k\">serves</span><span class=\"vAULUW_v\">Startups → Enterprises</span></div><div class=\"vAULUW_line\"><span class=\"vAULUW_k\">status</span><span class=\"vAULUW_v\" style=\"color:var(--cyan)\">● Actively building</span></div></div></div><div class=\"reveal\" style=\"transition-delay:.1s\"><div class=\"eyebrow\">About Htech</div><h2>Your technology partner for digital growth.</h2><p style=\"margin-top:20px;max-width:520px\">For over a decade, Htech Solutions has helped startups, SMEs and enterprises turn ambitious ideas into dependable software. We work as an embedded technology partner — not a vendor — combining engineering discipline with a genuine stake in your outcomes: secure architecture, scalable platforms, and support that continues long after launch.</p><a href=\"#contact\" class=\"btn btn-ghost\" style=\"margin-top:30px\">Discover Htech <span class=\"btn-arrow\">→</span></a></div></div></section><div style=\"overflow:hidden\"><div style=\"display:flex;align-items:center;width:max-content;height:100vh;flex-wrap:nowrap\"><section class=\"section\" id=\"services\" style=\"width:max-content;min-width:100vw;padding:60px 40px\"><div class=\"section-head reveal\" style=\"padding-left:20px\"><div class=\"eyebrow\">What We Do</div><h2>End‑to‑end engineering, from architecture to launch.</h2></div><div class=\"dpHhBa_servicesGrid reveal\"><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">01</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line><polyline points=\"10 9 9 9 8 9\"></polyline></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">Software Development</h3><p class=\"dpHhBa_svcDesc\">Custom software and enterprise-grade platforms engineered around your workflow.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">02</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line><line x1=\"9\" y1=\"21\" x2=\"9\" y2=\"9\"></line></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">Web Applications</h3><p class=\"dpHhBa_svcDesc\">Modern, scalable, high-performance web applications built for growth.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">03</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\" ry=\"2\"></rect><line x1=\"12\" y1=\"18\" x2=\"12.01\" y2=\"18\"></line></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">Mobile Applications</h3><p class=\"dpHhBa_svcDesc\">Native Android, iOS and cross-platform apps with one shared codebase where it counts.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">04</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">AI &amp; Machine Learning</h3><p class=\"dpHhBa_svcDesc\">AI-powered applications, automation and analytics that make systems smarter.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">05</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">Cloud Services</h3><p class=\"dpHhBa_svcDesc\">Cloud infrastructure, migration, deployment, security and cost optimization.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">06</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"16\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"8\" x2=\"12.01\" y2=\"8\"></line></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">IT Consulting</h3><p class=\"dpHhBa_svcDesc\">Technology strategy that turns digital transformation into a measurable plan.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">07</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">Cybersecurity</h3><p class=\"dpHhBa_svcDesc\">Application security, data protection, vulnerability assessment and consulting.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div class=\"dpHhBa_svcCard glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><div class=\"dpHhBa_watermark\">08</div><div class=\"dpHhBa_cardHeader\"><div class=\"dpHhBa_svcIconWrapper\"><div class=\"dpHhBa_svcIcon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg></div></div></div><div class=\"dpHhBa_cardBody\"><h3 class=\"dpHhBa_svcTitle\">Managed IT Services</h3><p class=\"dpHhBa_svcDesc\">Infrastructure management, monitoring, maintenance and technical support.</p></div><div class=\"dpHhBa_cardFooter\"><span class=\"dpHhBa_svcLink\">Learn more <span class=\"dpHhBa_arrow\">→</span></span></div></div></div><div style=\"width:40px;flex-shrink:0\" aria-hidden=\"true\"></div></div></section></div></div><section class=\"section\" id=\"industries\" style=\"width:100%\"><div class=\"wrap\"><div class=\"section-head reveal\"><div class=\"eyebrow\">Industries</div><h2>Built for the sectors that can&#x27;t afford downtime.</h2></div><div class=\"OOIqcq_industryRow reveal\"><div class=\"OOIqcq_industryCard\"><h4>Healthcare</h4><p>Secure, compliant systems for patient data and care delivery.</p></div><div class=\"OOIqcq_industryCard\"><h4>Finance &amp; Banking</h4><p>Resilient platforms built for accuracy, audit and scale.</p></div><div class=\"OOIqcq_industryCard\"><h4>Education</h4><p>Digital learning and campus systems that scale with enrollment.</p></div><div class=\"OOIqcq_industryCard\"><h4>Retail &amp; E‑Commerce</h4><p>Storefronts and backends engineered for peak traffic.</p></div><div class=\"OOIqcq_industryCard\"><h4>Manufacturing</h4><p>Automation and monitoring across the production line.</p></div><div class=\"OOIqcq_industryCard\"><h4>Logistics &amp; Transportation</h4><p>Real-time tracking and fleet systems that move with you.</p></div><div class=\"OOIqcq_industryCard\"><h4>Government &amp; Public Sector</h4><p>Reliable, secure platforms for public services.</p></div><div class=\"OOIqcq_industryCard\"><h4>Telecommunications</h4><p>High-availability systems built for constant connectivity.</p></div></div></div></section><div style=\"overflow:hidden\"><div style=\"display:flex;align-items:center;width:max-content;height:100vh;flex-wrap:nowrap\"><section class=\"section\" id=\"process\" style=\"width:max-content;min-width:100vw;padding:60px 40px\"><div class=\"section-head reveal\" style=\"padding-left:20px\"><div class=\"eyebrow\">How We Build</div><h2>Six stages. One accountable partner.</h2></div><div class=\"RmMdVa_processTimeline reveal\"><div class=\"RmMdVa_pStep \"><div class=\"RmMdVa_dot\"></div><div class=\"RmMdVa_contentBox\"><span class=\"RmMdVa_pNum\">01 · DISCOVER</span><h3>Requirement Analysis</h3><p>We study your business, users and constraints before writing a single spec.</p></div></div><div class=\"RmMdVa_pStep \"><div class=\"RmMdVa_dot\"></div><div class=\"RmMdVa_contentBox\"><span class=\"RmMdVa_pNum\">02 · PLAN</span><h3>Solution Planning &amp; Design</h3><p>Architecture, UX and technical roadmap, agreed before development begins.</p></div></div><div class=\"RmMdVa_pStep \"><div class=\"RmMdVa_dot\"></div><div class=\"RmMdVa_contentBox\"><span class=\"RmMdVa_pNum\">03 · BUILD</span><h3>Development</h3><p>Iterative sprints with visibility into progress at every stage.</p></div></div><div class=\"RmMdVa_pStep \"><div class=\"RmMdVa_dot\"></div><div class=\"RmMdVa_contentBox\"><span class=\"RmMdVa_pNum\">04 · TEST</span><h3>Testing &amp; Quality Assurance</h3><p>Functional, security and performance testing before anything ships.</p></div></div><div class=\"RmMdVa_pStep \"><div class=\"RmMdVa_dot\"></div><div class=\"RmMdVa_contentBox\"><span class=\"RmMdVa_pNum\">05 · LAUNCH</span><h3>Deployment</h3><p>Controlled, monitored releases with rollback plans in place.</p></div></div><div class=\"RmMdVa_pStep RmMdVa_lastStep\"><div class=\"RmMdVa_dot\"></div><div class=\"RmMdVa_contentBox\"><span class=\"RmMdVa_pNum\">06 · GROW</span><h3>Maintenance &amp; Support</h3><p>Ongoing monitoring, updates and support as your product evolves.</p></div></div><div style=\"width:40px;flex-shrink:0\" aria-hidden=\"true\"></div></div></section></div></div><div style=\"overflow:hidden\"><div style=\"display:flex;align-items:center;width:max-content;height:100vh;flex-wrap:nowrap\"><section class=\"section bg-1\" id=\"technology\" style=\"width:max-content;min-width:100vw;padding:60px 40px\"><div class=\"section-head reveal\" style=\"padding-left:20px\"><div class=\"eyebrow\">Technology Ecosystem</div><h2>A stack chosen for the problem, not the trend.</h2></div><div class=\"obZCcW_techCols reveal\"><div class=\"obZCcW_techCol glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><h4>Frontend</h4><div class=\"obZCcW_techTags\"><span class=\"obZCcW_tag\">React</span><span class=\"obZCcW_tag\">Next.js</span><span class=\"obZCcW_tag\">Angular</span><span class=\"obZCcW_tag\">Vue</span><span class=\"obZCcW_tag\">TypeScript</span><span class=\"obZCcW_tag\">JavaScript</span></div></div></div><div class=\"obZCcW_techCol glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><h4>Backend</h4><div class=\"obZCcW_techTags\"><span class=\"obZCcW_tag\">Node.js</span><span class=\"obZCcW_tag\">Java</span><span class=\"obZCcW_tag\">Python</span><span class=\"obZCcW_tag\">.NET</span><span class=\"obZCcW_tag\">PHP</span><span class=\"obZCcW_tag\">GraphQL</span><span class=\"obZCcW_tag\">REST APIs</span></div></div></div><div class=\"obZCcW_techCol glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><h4>Mobile</h4><div class=\"obZCcW_techTags\"><span class=\"obZCcW_tag\">Flutter</span><span class=\"obZCcW_tag\">React Native</span><span class=\"obZCcW_tag\">Android</span><span class=\"obZCcW_tag\">iOS</span></div></div></div><div class=\"obZCcW_techCol glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><h4>Databases</h4><div class=\"obZCcW_techTags\"><span class=\"obZCcW_tag\">PostgreSQL</span><span class=\"obZCcW_tag\">MySQL</span><span class=\"obZCcW_tag\">MongoDB</span><span class=\"obZCcW_tag\">SQL Server</span><span class=\"obZCcW_tag\">Redis</span></div></div></div><div class=\"obZCcW_techCol glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><h4>Cloud</h4><div class=\"obZCcW_techTags\"><span class=\"obZCcW_tag\">AWS</span><span class=\"obZCcW_tag\">Azure</span><span class=\"obZCcW_tag\">Google Cloud</span></div></div></div><div class=\"obZCcW_techCol glass\" style=\"transform-style:preserve-3d;perspective:1000px;transform:none\"><div style=\"transform:translateZ(30px);height:100%\"><h4>DevOps</h4><div class=\"obZCcW_techTags\"><span class=\"obZCcW_tag\">Docker</span><span class=\"obZCcW_tag\">Kubernetes</span><span class=\"obZCcW_tag\">Jenkins</span><span class=\"obZCcW_tag\">GitHub Actions</span><span class=\"obZCcW_tag\">CI/CD</span></div></div></div><div style=\"width:40px;flex-shrink:0\" aria-hidden=\"true\"></div></div></section></div></div><section class=\"section bg-1\"><div class=\"wrap\"><div class=\"section-head reveal\"><div class=\"eyebrow\">Why Htech</div><h2>Reasons technology leaders choose to build with us.</h2></div><div class=\"h8oZ9a_whyGrid reveal\"><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">01</span><h4>Experienced Professionals</h4><p>A senior team with a decade of production engineering behind it.</p></div><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">02</span><h4>Customized Solutions</h4><p>No templates — every build starts from your actual requirements.</p></div><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">03</span><h4>Innovation-Driven</h4><p>We evaluate new tools and approaches, and use them only when they earn their place.</p></div><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">04</span><h4>Customer-Centric</h4><p>You&#x27;re looped into decisions, not just delivery dates.</p></div><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">05</span><h4>Quality &amp; Security</h4><p>Testing and security review are part of the build, not an afterthought.</p></div><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">06</span><h4>Competitive Pricing</h4><p>Transparent scoping so you know exactly what you&#x27;re paying for.</p></div><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">07</span><h4>Timely Delivery</h4><p>Realistic timelines, and a plan for what happens if scope changes.</p></div><div class=\"h8oZ9a_whyCard\"><span class=\"h8oZ9a_whyMark\">08</span><h4>Long-Term Support</h4><p>We stay on after launch — maintenance, monitoring and updates.</p></div></div></div></section><section class=\"section\"><div class=\"wrap\"><div class=\"qlNzKa_ctaBand reveal\"><div class=\"eyebrow\" style=\"justify-content:center\">Ready When You Are</div><h2>Let&#x27;s build the future together.</h2><p class=\"lead\">Whether you&#x27;re building your first digital product or transforming an enterprise, Htech Solutions is ready to become your technology partner.</p><div class=\"qlNzKa_ctaActions\"><a href=\"#contact\" class=\"btn btn-primary\">Start a Conversation <span class=\"btn-arrow\">→</span></a></div></div></div></section><section class=\"section bg-1\" id=\"contact\"><div class=\"wrap hcVmEa_contactGrid\"><div class=\"reveal\"><div class=\"eyebrow\">Contact</div><h2>Let&#x27;s build something exceptional together.</h2><p style=\"margin-top:20px;max-width:420px\">Tell us about your project and we&#x27;ll get back to you within one business day.</p><div style=\"margin-top:44px;font-size:14.5px\"><p style=\"color:var(--text-0);font-weight:600;margin-bottom:6px\">Htech Solutions Pvt. Ltd.</p><p>431/B Pushpak Corner, Nr. Devi Cinema,<br/>Naroda, Ahmedabad – 382330, India</p><p style=\"margin-top:14px\">+91 79846 49969<br/>+91 94085 34684</p><p style=\"margin-top:14px\"><a href=\"mailto:harikesh@htechsolution.net\" style=\"color:var(--cyan)\">harikesh@htechsolution.net</a><br/><a href=\"mailto:mahil@htechsolution.net\" style=\"color:var(--cyan)\">mahil@htechsolution.net</a></p></div></div><form class=\"reveal\" style=\"transition-delay:.1s\"><div class=\"hcVmEa_formRow\"><div><label style=\"display:block;font-size:12.5px;font-family:var(--mono);color:var(--text-2);margin-bottom:8px\">FULL NAME</label><input required=\"\" type=\"text\" style=\"width:100%;padding:13px 14px;background:var(--bg-card);border:1px solid var(--line-strong);border-radius:8px;color:var(--text-0);font-family:var(--body);font-size:14px\"/></div><div><label style=\"display:block;font-size:12.5px;font-family:var(--mono);color:var(--text-2);margin-bottom:8px\">COMPANY NAME</label><input type=\"text\" style=\"width:100%;padding:13px 14px;background:var(--bg-card);border:1px solid var(--line-strong);border-radius:8px;color:var(--text-0);font-family:var(--body);font-size:14px\"/></div></div><div class=\"hcVmEa_formRow\" style=\"margin-top:16px\"><div><label style=\"display:block;font-size:12.5px;font-family:var(--mono);color:var(--text-2);margin-bottom:8px\">EMAIL</label><input required=\"\" type=\"email\" style=\"width:100%;padding:13px 14px;background:var(--bg-card);border:1px solid var(--line-strong);border-radius:8px;color:var(--text-0);font-family:var(--body);font-size:14px\"/></div><div><label style=\"display:block;font-size:12.5px;font-family:var(--mono);color:var(--text-2);margin-bottom:8px\">PHONE</label><input type=\"tel\" style=\"width:100%;padding:13px 14px;background:var(--bg-card);border:1px solid var(--line-strong);border-radius:8px;color:var(--text-0);font-family:var(--body);font-size:14px\"/></div></div><div class=\"hcVmEa_formRow\" style=\"margin-top:16px\"><div><label style=\"display:block;font-size:12.5px;font-family:var(--mono);color:var(--text-2);margin-bottom:8px\">SERVICE INTERESTED IN</label><select style=\"width:100%;padding:13px 14px;background:var(--bg-card);border:1px solid var(--line-strong);border-radius:8px;color:var(--text-0);font-family:var(--body);font-size:14px\"><option>Software Development</option><option>Web Application Development</option><option>Mobile Application Development</option><option>AI &amp; Machine Learning</option><option>Cloud Services</option><option>IT Consulting &amp; Digital Transformation</option><option>Cybersecurity</option><option>Managed IT Services</option></select></div><div><label style=\"display:block;font-size:12.5px;font-family:var(--mono);color:var(--text-2);margin-bottom:8px\">ESTIMATED BUDGET</label><select style=\"width:100%;padding:13px 14px;background:var(--bg-